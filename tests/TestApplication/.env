###> doctrine/doctrine-bundle ###
DATABASE_URL=mysql://root@127.0.0.1/sylius_paypal_%kernel.environment%
###< doctrine/doctrine-bundle ###

###> sylius/test-application ###
CONFIGS_TO_IMPORT="@SyliusPayPalPlugin/tests/TestApplication/config/config.yaml"
ROUTES_TO_IMPORT="@SyliusPayPalPlugin/config/routes.yaml"
TEST_APP_BUNDLES_PATH="tests/TestApplication/config/bundles.php"
###< sylius/test-application ###

###> sylius/payment-bundle ###
SYLIUS_PAYMENT_ENCRYPTION_KEY_PATH=%kernel.project_dir%/../../../tests/TestApplication/config/encryption/test.key
###< sylius/payment-bundle ###

###> symfony/messenger ###
SYLIUS_MESSENGER_TRANSPORT_PAYMENT_REQUEST_DSN=sync://
SYLIUS_MESSENGER_TRANSPORT_PAYMENT_REQUEST_FAILED_DSN=sync://
###< symfony/messenger ###

###> sylius/paypal-plugin ###
SYLIUS_PAYPAL_SANDBOX_ENABLED=true
SYLIUS_PAYPAL_LOGGING_INCREASED=true
###< sylius/paypal-plugin ###
