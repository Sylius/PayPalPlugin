<div
    {{ stimulus_controller('@sylius/paypal-plugin/paypal-web-sdk', {
        scriptUrl: webSdkScriptUrl,
        instanceConfig: webSdkInstanceConfig,
        currencyCode: currency,
        amount: amount,
        createOrderUrl: createPayPalOrderFromCartUrl,
        captureOrderUrl: completeExpressCheckoutUrl,
        cancelOrderUrl: path('sylius_paypal_shop_cancel_order'),
        errorUrl: errorPayPalPaymentUrl,
        payLaterEnabled: paylaterEnabled,
        venmoEnabled: venmoEnabled,
        venmoButtonSelector: '[data-sylius-paypal-venmo-button]',
    }) }}
    class="d-grid gap-2"
    style="width:250px"
>
    <paypal-button {{ stimulus_target('@sylius/paypal-plugin/paypal-web-sdk', 'paypalButton') }} type="pay" class="paypal-gold" style="display: block; width: 100%" hidden></paypal-button>
    <paypal-pay-later-button {{ stimulus_target('@sylius/paypal-plugin/paypal-web-sdk', 'payLaterButton') }} style="display: block; width: 100%" hidden></paypal-pay-later-button>
</div>
