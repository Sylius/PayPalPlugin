{% if sylius_paypal_is_messaging_enabled() %}
    {% set order = hookable_metadata.context.order %}

    <paypal-message
        class="d-block mb-3"
        {{ stimulus_controller('@sylius/paypal-plugin/paypal-message', {
            amount: (order.total / 100)|number_format(2, '.', ''),
            currencyCode: order.currencyCode,
            scriptUrl: sylius_paypal_web_sdk_script_url(),
            instanceConfig: sylius_paypal_web_sdk_instance_config('checkout'),
        }) }}
    ></paypal-message>
{% endif %}
