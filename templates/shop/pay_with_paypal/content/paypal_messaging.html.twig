{% if sylius_paypal_is_messaging_enabled() %}
    {% set context = hookable_metadata.context %}

    <paypal-message
        class="mb-3"
        {{ stimulus_controller('@sylius/paypal-plugin/paypal-message', {
            amount: context.amount,
            currencyCode: context.currency,
            scriptUrl: sylius_paypal_web_sdk_script_url(),
            instanceConfig: sylius_paypal_web_sdk_instance_config('checkout', context.locale),
        }) }}
        hidden
    ></paypal-message>
{% endif %}
