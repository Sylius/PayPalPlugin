{% set context = hookable_metadata.context %}

{% if context.messagingEnabled %}
    <paypal-message
        class="mb-3"
        style="display: block"
        {{ stimulus_controller('@sylius/paypal-plugin/paypal-message', {
            amount: context.amount,
            currencyCode: context.currency,
            scriptUrl: context.webSdkScriptUrl,
            instanceConfig: context.messagingInstanceConfig,
        }) }}
        hidden
    ></paypal-message>
{% endif %}
