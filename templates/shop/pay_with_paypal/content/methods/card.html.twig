{% import '@SyliusShop/shared/buttons.html.twig' as buttons %}

{% set context = hookable_metadata.context %}
{% set billingAddress = context.billingAddress|default(null) %}

<style>
    .paypal-card-field > * {
        display: block;
        width: 100%;
        height: 2.75rem;
    }
</style>

<div
    {{ stimulus_controller('@sylius/paypal-plugin/paypal-payment-card-fields', {
        scriptUrl: context.webSdkScriptUrl,
        instanceConfig: context.webSdkInstanceConfig,
        currencyCode: context.currency,
        createOrderUrl: context.createPayPalOrderUrl,
        completeOrderUrl: context.completePayPalOrderUrl,
        errorUrl: context.errorPayPalPaymentUrl,
        billingAddress: billingAddress is null ? {} : {
            streetAddress: billingAddress.street,
            city: billingAddress.city,
            postalCode: billingAddress.postcode,
            countryCode: billingAddress.countryCode,
        },
    }) }}
    class="position-relative border-top pt-4"
    hidden
>
    <form {{ stimulus_target('@sylius/paypal-plugin/paypal-payment-card-fields', 'form') }}>
        <div class="mb-3">
            <label class="form-label">{{ 'sylius_paypal.card_number'|trans }}</label>
            <div
                class="paypal-card-field"
                {{ stimulus_target('@sylius/paypal-plugin/paypal-payment-card-fields', 'number') }}
            ></div>
        </div>

        <div class="row">
            <div class="col-6 mb-3">
                <label class="form-label">{{ 'sylius_paypal.expiration_date'|trans }}</label>
                <div
                    class="paypal-card-field"
                    {{ stimulus_target('@sylius/paypal-plugin/paypal-payment-card-fields', 'expiry') }}
                ></div>
            </div>
            <div class="col-6 mb-3">
                <label class="form-label">{{ 'sylius_paypal.cvv'|trans }}</label>
                <div
                    class="paypal-card-field"
                    {{ stimulus_target('@sylius/paypal-plugin/paypal-payment-card-fields', 'cvv') }}
                ></div>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label">{{ 'sylius_paypal.cardholder_name'|trans }}</label>
            <div
                class="paypal-card-field"
                {{ stimulus_target('@sylius/paypal-plugin/paypal-payment-card-fields', 'name') }}
            ></div>
        </div>

        <div class="btn-list">
            {{ buttons.submit('sylius_paypal.pay_with_card', 'paypal-pay-with-card', null, 'btn-primary') }}
            {{ buttons.default(
                path('sylius_shop_order_show', { tokenValue: context.order.tokenValue }),
                'sylius.ui.cancel',
                null,
                null,
                ''
            ) }}
        </div>
    </form>

    <div
        {{ stimulus_target('@sylius/paypal-plugin/paypal-payment-card-fields', 'loader') }}
        class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75"
        hidden
    >
        <div class="d-flex align-items-center justify-content-center h-100">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">{{ 'sylius.ui.loading'|trans }}</span>
            </div>
        </div>
    </div>
</div>
