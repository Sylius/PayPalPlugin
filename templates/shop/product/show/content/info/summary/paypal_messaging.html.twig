{% set variant = hookable_metadata.context.variant|default(null) %}

{% if variant is not null and sylius_paypal_is_messaging_enabled() %}
    <paypal-message
        auto-bootstrap
        amount="{{ (variant|sylius_calculate_price({'channel': sylius.channel}) / 100)|number_format(2, '.', '') }}"
        currency-code="{{ sylius.channel.baseCurrency.code }}"
    ></paypal-message>
{% endif %}
