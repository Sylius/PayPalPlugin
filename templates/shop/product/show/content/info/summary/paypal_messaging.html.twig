{% set variant = hookable_metadata.context.variant|default(null) %}

{% if variant is not null and sylius_paypal_is_messaging_enabled() %}
    <paypal-message
        class="mb-3"
        {{ stimulus_controller('@sylius/paypal-plugin/paypal-message', {
            amount: (variant|sylius_calculate_price({'channel': sylius.channel}) / 100)|number_format(2, '.', ''),
            currencyCode: sylius.channel.baseCurrency.code,
            scriptUrl: sylius_paypal_web_sdk_script_url(),
            instanceConfig: sylius_paypal_web_sdk_instance_config('product-details'),
        }) }}
        hidden
    ></paypal-message>
{% endif %}
