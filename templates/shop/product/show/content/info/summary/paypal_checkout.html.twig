{% set product = hookable_metadata.context.product %}

{% if not (product.enabledVariants.empty() or product.simple and not sylius_inventory_is_available(product.enabledVariants.first)) %}
    <div class="mb-4" data-live-ignore>
        {{ render(controller('sylius_paypal.controller.paypal_buttons::renderProductPageButtonsAction', { productId: product.id })) }}
    </div>
{% endif %}
