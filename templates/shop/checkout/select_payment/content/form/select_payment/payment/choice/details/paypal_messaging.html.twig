{% if
    hookable_metadata.context.method.gatewayConfig.factoryName|default('') == constant('Sylius\\PayPalPlugin\\DependencyInjection\\SyliusPayPalExtension::PAYPAL_FACTORY_NAME') and
    sylius_paypal_is_messaging_enabled()
%}
    {% set order = hookable_metadata.context.order %}

    <paypal-message
        {{ stimulus_controller('@sylius/paypal-plugin/paypal-message', {
            amount: order.total / 100,
            currencyCode: order.currencyCode,
            scriptUrl: sylius_paypal_web_sdk_script_url(),
            instanceConfig: sylius_paypal_web_sdk_instance_config('checkout'),
        }) }}
    ></paypal-message>
{% endif %}
