{% set payment = hookable_metadata.context.payment %}

{% if sylius_paypal_is_awaiting_payer_action(payment) %}
    <div>
        <i>{{ 'sylius_paypal.awaiting_payer_action'|trans }}</i>
    </div>
    <a href="{{ sylius_paypal_payer_action_url(payment) }}" class="btn btn-sm btn-outline-secondary mt-2">
        {{ 'sylius_paypal.finish_the_payment'|trans }}
    </a>
{% endif %}
