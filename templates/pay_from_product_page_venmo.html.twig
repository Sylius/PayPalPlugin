        scriptUrl: webSdkScriptUrl,
        instanceConfig: webSdkInstanceConfig,
        currencyCode: sylius.currencyCode,
        createOrderUrl: createPayPalOrderFromProductUrl,
        addToCartFormSelector: '[name="sylius_shop_add_to_cart"]',
