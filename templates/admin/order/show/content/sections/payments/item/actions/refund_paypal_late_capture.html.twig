{% set order = hookable_metadata.context.resource %}
{% set payment = hookable_metadata.context.payment %}
{% set late_capture = payment.details[constant('Sylius\\PayPalPlugin\\Processor\\PayPalPaymentSettlementProcessor::LATE_CAPTURE')] ?? null %}

{% if
    late_capture is not null and
    not late_capture.refunded|default(false) and
    payment.method.gatewayConfig.factoryName|default('') == constant('Sylius\\PayPalPlugin\\DependencyInjection\\SyliusPayPalExtension::PAYPAL_FACTORY_NAME')
%}
    <form action="{{ path('sylius_paypal_admin_order_payment_refund_late_capture', {'orderId': order.id, 'id': payment.id}) }}" method="POST" novalidate>
        <input type="hidden" name="_method" value="PUT">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token(payment.id) }}" />
        <button type="submit" class="btn" {{ sylius_test_html_attribute('refund-paypal-late-capture', payment.id) }}>
            {{ ux_icon('tabler:arrow-back-up-double') }} {{ 'sylius.ui.refund'|trans }}
        </button>
    </form>
{% endif %}
