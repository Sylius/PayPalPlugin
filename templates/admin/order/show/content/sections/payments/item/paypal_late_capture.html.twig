{% import '@SyliusAdmin/shared/helper/money.html.twig' as money %}

{% set payment = hookable_metadata.context.payment %}
{% set late_capture = payment.details[constant('Sylius\\PayPalPlugin\\Processor\\PayPalPaymentSettlementProcessor::LATE_CAPTURE')] ?? null %}

{% if
    late_capture is not null and
    payment.method.gatewayConfig.factoryName|default('') == constant('Sylius\\PayPalPlugin\\DependencyInjection\\SyliusPayPalExtension::PAYPAL_FACTORY_NAME')
%}
    {% set captured = money.format(late_capture.amount, late_capture.currency_code) %}
    <td class="py-2">
        <div class="alert alert-warning mb-0" role="alert" {{ sylius_test_html_attribute('paypal-late-capture', payment.id) }}>
            <div class="d-flex">
                <div>{{ ux_icon('tabler:alert-triangle') }}</div>
                <div>
                    {% if late_capture.refunded|default(false) %}
                        {{ 'sylius_paypal.late_capture_refunded'|trans({'%amount%': captured}) }}
                    {% else %}
                        {{ 'sylius_paypal.late_capture'|trans({'%amount%': captured}) }}
                    {% endif %}
                </div>
            </div>
        </div>
    </td>
{% endif %}
