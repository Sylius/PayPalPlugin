{% macro label(code) %}
    {%- set labels = {
        amex: 'American Express',
        apple_pay: 'Apple Pay',
        google_pay: 'Google Pay',
        master_card: 'Mastercard',
        paypal: 'PayPal',
        venmo: 'Venmo',
        visa: 'Visa',
    } -%}
    {{- labels[code]|default(code|replace({'_': ' '})|title) -}}
{% endmacro %}

{% macro image(code) %}
    <img src="{{ asset('build/app/admin/images/' ~ code ~ '.svg', 'app.admin') }}" alt="{{ _self.label(code)|trim }}">
{% endmacro %}
