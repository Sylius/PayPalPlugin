{% set state = this.state %}

<div {{ attributes }}>
    {% if variant == 'alert' and registration is not null %}
        <div class="alert alert-success" role="alert" {{ sylius_test_html_attribute('paypal-webhook-update', 'success') }}>
            {% if registration.isNew() %}
                {{ 'sylius_paypal.webhook_registered'|trans({'%id%': registration.id(), '%url%': registration.url()}) }}
            {% elseif registration.isUpToDate() %}
                {{ 'sylius_paypal.webhook_already_up_to_date'|trans({'%id%': registration.id(), '%url%': registration.url()}) }}
            {% else %}
                {{ 'sylius_paypal.webhook_updated'|trans({'%id%': registration.id(), '%url%': registration.url()}) }}
            {% endif %}
        </div>
    {% endif %}

    {% if variant == 'alert' and updateFailed %}
        <div class="alert alert-danger" role="alert" {{ sylius_test_html_attribute('paypal-webhook-update', 'error') }}>
            {% if updateError is null %}
                {{ 'sylius_paypal.webhook_not_updated_check_logs'|trans }}
            {% else %}
                {{ 'sylius_paypal.webhook_not_updated'|trans({'%reason%': updateError}) }}
            {% endif %}
        </div>
    {% endif %}

    {% if state is not null and not state.isUpToDate() %}
        {% set problem = state.isRegistered() ? 'sylius_paypal.webhook_out_of_date' : 'sylius_paypal.webhook_not_registered' %}

        {% if variant == 'alert' %}
            <div class="alert alert-warning" role="alert" {{ sylius_test_html_attribute('paypal-webhook-state', state.isRegistered() ? 'out-of-date' : 'not-registered') }}>
                <div>
                    <div class="fw-bold">{{ problem|trans }}</div>
                    {% if state.pointsElsewhere() %}
                        <div>{{ 'sylius_paypal.webhook_points_elsewhere'|trans({'%url%': state.registeredUrl()}) }}</div>
                    {% endif %}
                    {% if state.missingEventTypes() is not empty %}
                        <div>{{ 'sylius_paypal.webhook_missing_event_types'|trans }} <code>{{ state.missingEventTypes()|join(', ') }}</code></div>
                    {% endif %}
                    <button
                        type="button"
                        class="btn btn-warning mt-2"
                        data-action="live#action"
                        data-live-action-param="updateWebhook"
                        data-loading="addAttribute(disabled)"
                        {{ sylius_test_html_attribute('paypal-webhook-update-button') }}
                    >
                        {{ 'sylius_paypal.update_webhook'|trans }}
                    </button>
                </div>
            </div>
        {% else %}
            <span class="badge bg-red-lt" title="{{ state.missingEventTypes()|join(', ') }}" {{ sylius_test_html_attribute('paypal-webhook-state', state.isRegistered() ? 'out-of-date' : 'not-registered') }}>{{ problem|trans }}</span>
        {% endif %}
    {% endif %}
</div>
