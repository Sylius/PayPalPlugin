{# Core's action renders a ship form without a carrier, so a PayPal-paid shipment could not be shipped with tracking from the list. #}
<div class="dropdown-item">
    {{ component('sylius_admin:shipment:ship_form', {
        resource: data,
        template: sylius_paypal_shipment_is_paid_with_paypal(data)
            ? '@SyliusPayPalPlugin/admin/shipment/component/ship_from_index.html.twig'
            : '@SyliusAdmin/shipment/component/ship.html.twig',
    }) }}
</div>
