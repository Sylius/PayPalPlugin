<div class="dropdown-item">
    {% if sylius_paypal_shipment_is_paid_with_paypal(data) %}
        {{ component('sylius_paypal_admin:shipment:ship_form', {
            resource: data,
            template: '@SyliusPayPalPlugin/admin/shipment/component/ship_from_index.html.twig',
        }) }}
    {% else %}
        {{ component('sylius_admin:shipment:ship_form', { resource: data, template: '@SyliusAdmin/shipment/component/ship.html.twig' }) }}
    {% endif %}
</div>
