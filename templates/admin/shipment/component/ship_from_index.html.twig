{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}

{% if sylius_sm_can(resource, 'sylius_shipment', 'ship') %}
    <div {{ attributes }}>
        {{ form_start(form, {'attr': {
            'class': 'ui loadable form',
            'novalidate': 'novalidate',
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'ship',
            'data-live-redirect-to-param': constant('Sylius\\PayPalPlugin\\PackageTracking\\Twig\\Component\\ShipmentShipFormComponent::REDIRECT_TO_INDEX'),
        }}) }}
        <div class="input-group flex-nowrap has-validation">
            {% hook 'sylius_paypal.admin.shipment.index.ship_form' with { form, resource } %}
        </div>
        {{ form_errors(form.tracking) }}
        {% if form.paypal_tracking is defined %}
            {{ form_errors(form.paypal_tracking.carrier) }}
            {{ form_errors(form.paypal_tracking.carrier_name_other) }}
        {% endif %}
        {{ form_end(form, {'render_rest': false}) }}
    </div>
{% endif %}
