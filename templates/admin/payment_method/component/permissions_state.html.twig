{% set state = this.state %}

<div {{ attributes }}>
    {% if state is not null and not state.isUpToDate() %}
        {% set status = state.status().value %}

        {% if variant == constant('Sylius\\PayPalPlugin\\Twig\\Component\\PermissionsStateComponent::VARIANT_ALERT') %}
            <div class="alert alert-warning" role="alert" {{ sylius_test_html_attribute('paypal-permissions-state', status) }}>
                <div class="alert-icon">{{ ux_icon('tabler:alert-triangle') }}</div>
                <div>
                    <h4 class="alert-heading">{{ ('sylius_paypal.permissions.state.' ~ status)|trans }}</h4>
                    <div>
                        {% if state.isKnown() %}
                            {{ 'sylius_paypal.permissions.state.missing'|trans }} <code>{{ state.missing()|join(', ') }}</code>
                        {% else %}
                            {{ 'sylius_paypal.permissions.state.unknown_details'|trans }}
                        {% endif %}
                    </div>
                    <button
                        type="button"
                        class="btn mt-2"
                        data-bs-toggle="modal"
                        data-bs-target="#{{ constant('Sylius\\PayPalPlugin\\Twig\\Component\\PayPalOnboardingModalComponent::PERMISSIONS_UPDATE_MODAL_ID') }}"
                        {{ sylius_test_html_attribute('paypal-permissions-update-button') }}
                    >
                        {{ 'sylius_paypal.permissions.update.button'|trans }}
                    </button>
                </div>
            </div>
        {% else %}
            <span class="badge {{ state.isKnown() ? 'bg-red-lt' : 'bg-orange-lt' }}" title="{{ state.missing()|join(', ') }}" {{ sylius_test_html_attribute('paypal-permissions-state', status) }}>{{ ('sylius_paypal.permissions.state.' ~ status)|trans }}</span>
        {% endif %}
    {% endif %}
</div>
