{% set form = hookable_metadata.context.form.gatewayConfig.config %}

{#- merchant_id is a hidden form field that keeps its stored value on submit, so it is only displayed here. -#}
<div class="col-12 col-md-6 mb-3">
    <label class="form-label" for="paypal-merchant-id">{{ 'sylius_paypal.merchant_id'|trans }}</label>
    <input type="text" id="paypal-merchant-id" class="form-control" value="{{ form.merchant_id.vars.value }}" readonly {{ sylius_test_html_attribute('merchant-id') }}>
</div>
