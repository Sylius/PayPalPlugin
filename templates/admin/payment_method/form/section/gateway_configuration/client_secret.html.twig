{% set form = hookable_metadata.context.form.gatewayConfig.config %}

<div class="col-12 mb-3" {{ sylius_test_html_attribute('client-secret') }}>
    <div class="form-label fw-medium">{{ form.client_secret.vars.label|trans }}</div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        {% if form.client_secret.vars.value is not empty %}
            <span class="badge bg-teal-lt" {{ sylius_test_html_attribute('client-secret-status', 'stored') }}>{{ 'sylius_paypal.client_secret_stored'|trans }}</span>
        {% else %}
            <span class="badge bg-orange-lt" {{ sylius_test_html_attribute('client-secret-status', 'missing') }}>{{ 'sylius_paypal.client_secret_missing'|trans }}</span>
        {% endif %}
        <span class="text-muted small">{{ 'sylius_paypal.client_secret_help'|trans }}</span>
    </div>
</div>
