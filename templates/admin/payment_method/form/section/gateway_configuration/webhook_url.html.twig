{% set payment_method = hookable_metadata.context.resource ?? null %}
{% set config = (payment_method is not null and payment_method.gatewayConfig is not null) ? payment_method.gatewayConfig.config : {} %}
{% set webhook_url = config[constant('Sylius\\PayPalPlugin\\Model\\PayPalGatewayConfig::WEBHOOK_URL')]|default(null) %}

<div class="col-12">
    <div class="mb-3">
        <label class="form-label" for="paypal-webhook-url">{{ 'sylius_paypal.webhook.url.label'|trans }}</label>
        <input type="text" id="paypal-webhook-url" class="form-control" value="{{ webhook_url }}" placeholder="{{ 'sylius_paypal.webhook.url.not_stored'|trans }}" disabled {{ sylius_test_html_attribute('paypal-webhook-url', webhook_url ?? 'unknown') }}>
    </div>
</div>
