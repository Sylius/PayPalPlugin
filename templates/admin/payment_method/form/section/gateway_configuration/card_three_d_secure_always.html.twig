{% import '@SyliusPayPalPlugin/admin/shared/helper/info_tooltip.html.twig' as info_tooltip %}

{% set form = hookable_metadata.context.form.gatewayConfig.config %}

<div class="d-flex align-items-center gap-3">
    <span class="flex-shrink-0" style="width: 3.5rem;"></span>
    <div class="flex-grow-1">
        <label class="fw-medium" for="{{ form.card_three_d_secure_always.vars.id }}">{{ form.card_three_d_secure_always.vars.label|trans }}</label>
            {{- info_tooltip.icon('sylius_paypal.card_three_d_secure_always_info', form.card_three_d_secure_always.vars.label, 'card_three_d_secure_always') }}
        <div class="text-muted small">{{ 'sylius_paypal.card_three_d_secure_always_help'|trans }}</div>
    </div>
    <div class="flex-shrink-0">
        {{ form_widget(form.card_three_d_secure_always, sylius_test_form_attribute('card-three-d-secure-always')|merge({ label: false, label_attr: { class: 'checkbox-switch' } })) }}
    </div>
</div>
