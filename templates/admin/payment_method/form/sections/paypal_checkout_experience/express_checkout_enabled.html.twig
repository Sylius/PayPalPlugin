{% set form = hookable_metadata.context.form.gatewayConfig.config %}

<div class="list-group-item py-3">
    <div class="d-flex align-items-center gap-3">
        <div class="flex-grow-1">
            <label class="fw-medium" for="{{ form.express_checkout_enabled.vars.id }}">{{ form.express_checkout_enabled.vars.label|trans }}</label>
            <div class="text-muted small">{{ 'sylius_paypal.express_checkout_enabled_help'|trans }}</div>
        </div>
        <div class="flex-shrink-0">
            {{ form_widget(form.express_checkout_enabled, sylius_test_form_attribute('express-checkout-enabled')|merge({ label: false, label_attr: { class: 'checkbox-switch' } })) }}
        </div>
    </div>
</div>
