{% set payment_method = hookable_metadata.context.resource %}

{% if payment_method.gatewayConfig.factoryName|default('') == constant('Sylius\\PayPalPlugin\\DependencyInjection\\SyliusPayPalExtension::PAYPAL_FACTORY_NAME') %}
    {% set sandbox = payment_method.gatewayConfig.config[constant('Sylius\\PayPalPlugin\\Model\\PayPalGatewayConfig::SANDBOX')]|default(false) %}

    {# the surface layer keeps the translucent alert background light on the grey page #}
    <div class="bg-surface rounded mb-3">
        {% if sandbox and app.environment == 'prod' %}
            <div class="alert alert-danger mb-0" role="alert" {{ sylius_test_html_attribute('paypal-mode', 'sandbox') }}>
                <div class="d-flex gap-2">
                    {{ ux_icon('tabler:alert-triangle-filled', { class: 'icon alert-icon me-1' }) }}
                    <div class="text-body">
                        <strong>{{ 'sylius_paypal.mode_sandbox_title'|trans }}</strong>
                        {{ 'sylius_paypal.sandbox_on_production_warning'|trans }}
                        <div class="text-muted mt-1">{{ 'sylius_paypal.mode_sandbox_go_live'|trans }}</div>
                    </div>
                </div>
            </div>
        {% elseif sandbox %}
            <div class="alert bg-yellow-lt border-warning-subtle mb-0" role="alert" {{ sylius_test_html_attribute('paypal-mode', 'sandbox') }}>
                <div class="d-flex gap-2">
                    {{ ux_icon('tabler:alert-triangle', { class: 'icon alert-icon text-orange me-1' }) }}
                    <div class="text-body">
                        <strong>{{ 'sylius_paypal.mode_sandbox_title'|trans }}</strong>
                        {{ 'sylius_paypal.mode_sandbox_description'|trans }}
                        <div class="text-muted mt-1">{{ 'sylius_paypal.mode_sandbox_go_live'|trans }}</div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert bg-green-lt border-success-subtle mb-0" role="alert" {{ sylius_test_html_attribute('paypal-mode', 'production') }}>
                <div class="d-flex gap-2">
                    {{ ux_icon('tabler:circle-check', { class: 'icon alert-icon text-green me-1' }) }}
                    <div class="text-body">
                        <strong>{{ 'sylius_paypal.mode_production_title'|trans }}</strong>
                        {{ 'sylius_paypal.mode_production_description'|trans }}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endif %}
