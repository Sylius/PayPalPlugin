includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-webmozart-assert/extension.neon

parameters:
    # The Symfony 8 row matches ignores that the Symfony 6.4 and 7.4 rows do not, and vice versa.
    reportUnmatchedIgnoredErrors: false

    level: 6

    paths:
        - src

    excludePaths:
        # Makes PHPStan crash
        - 'src/DependencyInjection/Configuration.php'

    ignoreErrors:
        - identifier: missingType.iterableValue

        # Symfony 8 made the workflow events generic over their subject, Symfony 6.4 and 7.4 did not,
        # so no single annotation satisfies every matrix row. Sylius' own workflow listeners are typed
        # the same way and the subject is asserted at runtime.
        - identifier: missingType.generics

        - '/Dead catch - Sylius\\PayPalPlugin\\Exception\\PayPalWebhookUrlNotValidException is never thrown in the try block\./' # architectural smell
