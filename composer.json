{
    "name": "sylius/paypal-plugin",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin"
    ],
    "description": "PayPal plugin for Sylius.",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "php-http/discovery": "^1.20",
        "phpseclib/phpseclib": "^3.0",
        "psr/http-client": "^1.0",
        "sylius-labs/doctrine-migrations-extra-bundle": "^0.2 || ^0.3",
        "sylius/sylius": "^2.0.1",
        "sylius/telemetry": "^1.0",
        "symfony/mailer": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "behat/behat": "^3.22 || 4.0.0-alpha1",
        "behat/mink": "^1.10 || ^1.13",
        "dmore/chrome-mink-driver": "^2.9",
        "friends-of-behat/mink-browserkit-driver": "^1.6.3",
        "friends-of-behat/mink-debug-extension": "^2.2",
        "friends-of-behat/mink-extension": "^2.7 || 3.0.0-alpha1",
        "friends-of-behat/page-object-extension": "^0.3.2 || ^0.4",
        "friends-of-behat/symfony-extension": "^2.6.2",
        "friends-of-behat/variadic-extension": "^1.6",
        "lchrusciel/api-test-case": "^6.0",
        "matthiasnoback/symfony-dependency-injection-test": "^6.2",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5",
        "sylius-labs/behat-chrome-extension": "^1.5",
        "sylius-labs/coding-standard": "^4.4",
        "sylius/sylius-rector": "^1.0",
        "sylius/test-application": "^2.0.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/debug-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/intl": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Sylius\\PayPalPlugin\\": "src/",
            "Tests\\Sylius\\PayPalPlugin\\": "tests/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sylius\\PayPalPlugin\\TestApplication\\": "tests/TestApplication/src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ocramius/package-versions": false,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "symfony/thanks": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        },
        "symfony": {
            "require": "^7.4"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "scripts": {
        "analyse": [
            "@composer validate --strict",
            "vendor/bin/phpstan.phar analyse"
        ],
        "fix": [
            "vendor/bin/ecs check src/ --fix"
        ]
    },
    "prefer-stable": true
}
