<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="sylius_paypal.listener.cart.assign_cart_token" class="Sylius\PayPalPlugin\EventListener\Cart\AssignCartTokenListener">
            <argument type="service" id="Sylius\Component\Core\TokenAssigner\OrderTokenAssignerInterface" />
            <argument type="service" id="sylius.manager.order" />

            <tag name="kernel.event_listener" event="sylius.cart_item_add" priority="100" />
        </service>
    </services>
</container>
