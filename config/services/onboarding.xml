<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service
            id="sylius_paypal.provider.seller_nonce"
            class="Sylius\PayPalPlugin\Provider\SellerNonceProvider"
        >
            <argument type="service" id="request_stack" />
        </service>
        <service id="Sylius\PayPalPlugin\Provider\SellerNonceProviderInterface" alias="sylius_paypal.provider.seller_nonce" />

        <service
            id="sylius_paypal.provider.partner_credentials"
            class="Sylius\PayPalPlugin\Provider\PartnerCredentialsProvider"
        >
            <argument type="service" id="sylius_paypal.api.onboarding_request_executor" />
            <argument type="service" id="Psr\Http\Message\RequestFactoryInterface" />
            <argument type="service" id="cache.app" />
            <argument>%sylius_paypal.partner_credentials_url%</argument>
            <argument>3600</argument>
            <argument>%sylius_paypal.partner_credentials.fallback_partner_id%</argument>
            <argument>%sylius_paypal.partner_credentials.fallback_partner_client_id%</argument>
        </service>
        <service id="Sylius\PayPalPlugin\Provider\PartnerCredentialsProviderInterface" alias="sylius_paypal.provider.partner_credentials" />

        <service
            id="sylius_paypal.provider.onboarding_url"
            class="Sylius\PayPalPlugin\Provider\PayPalOnboardingUrlProvider"
        >
            <argument>%sylius_paypal.web_url%</argument>
            <argument type="service" id="sylius_paypal.provider.partner_credentials" />
            <argument type="service" id="router" />
        </service>
        <service id="Sylius\PayPalPlugin\Provider\PayPalOnboardingUrlProviderInterface" alias="sylius_paypal.provider.onboarding_url" />
    </services>
</container>
