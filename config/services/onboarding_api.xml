<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <!-- Bounded timeout: onboarding calls happen synchronously during an admin request,
             so they must fail fast instead of inheriting the framework's unbounded default. -->
        <service id="sylius_paypal.http_client.onboarding" class="Symfony\Component\HttpClient\Psr18Client" public="false">
            <argument type="service">
                <service class="Symfony\Component\HttpClient\HttpClient">
                    <factory class="Symfony\Component\HttpClient\HttpClient" method="create" />
                    <argument type="collection">
                        <argument key="timeout">2</argument>
                        <argument key="max_duration">2</argument>
                    </argument>
                </service>
            </argument>
        </service>

        <service
            id="sylius_paypal.api.onboarding_request_executor"
            class="Sylius\PayPalPlugin\Api\PayPalOnboardingRequestExecutor"
        >
            <argument type="service" id="sylius_paypal.http_client.onboarding" />
            <argument type="service" id="monolog.logger.paypal" />
        </service>
        <service id="Sylius\PayPalPlugin\Api\PayPalOnboardingRequestExecutorInterface" alias="sylius_paypal.api.onboarding_request_executor" />

        <service
            id="sylius_paypal.api.onboarding_token"
            class="Sylius\PayPalPlugin\Api\OnboardingTokenApi"
        >
            <argument type="service" id="sylius_paypal.api.onboarding_request_executor" />
            <argument>%sylius_paypal.api_base_url%</argument>
            <argument type="service" id="Psr\Http\Message\RequestFactoryInterface" />
            <argument type="service" id="Psr\Http\Message\StreamFactoryInterface" />
        </service>
        <service id="Sylius\PayPalPlugin\Api\OnboardingTokenApiInterface" alias="sylius_paypal.api.onboarding_token" />

        <service
            id="sylius_paypal.api.seller_credentials"
            class="Sylius\PayPalPlugin\Api\SellerCredentialsApi"
        >
            <argument type="service" id="sylius_paypal.api.onboarding_request_executor" />
            <argument>%sylius_paypal.api_base_url%</argument>
            <argument type="service" id="Psr\Http\Message\RequestFactoryInterface" />
        </service>
        <service id="Sylius\PayPalPlugin\Api\SellerCredentialsApiInterface" alias="sylius_paypal.api.seller_credentials" />

        <service
            id="sylius_paypal.api.merchant_onboarding_status"
            class="Sylius\PayPalPlugin\Api\MerchantOnboardingStatusApi"
        >
            <argument type="service" id="sylius_paypal.api.onboarding_request_executor" />
            <argument type="service" id="Psr\Http\Message\RequestFactoryInterface" />
            <argument>%sylius_paypal.api_base_url%</argument>
        </service>
        <service id="Sylius\PayPalPlugin\Api\MerchantOnboardingStatusApiInterface" alias="sylius_paypal.api.merchant_onboarding_status" />

        <service
            id="sylius_paypal.onboarding.resolver.seller"
            class="Sylius\PayPalPlugin\Onboarding\Resolver\SellerOnboardingResolver"
        >
            <argument type="service" id="sylius_paypal.api.onboarding_token" />
            <argument type="service" id="sylius_paypal.api.seller_credentials" />
            <argument type="service" id="sylius_paypal.api.authorize_client" />
            <argument type="service" id="sylius_paypal.api.merchant_onboarding_status" />
            <argument type="service" id="sylius_paypal.provider.partner_credentials" />
        </service>
        <service id="Sylius\PayPalPlugin\Onboarding\Resolver\SellerOnboardingResolverInterface" alias="sylius_paypal.onboarding.resolver.seller" />
    </services>
</container>
